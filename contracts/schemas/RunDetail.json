{
  "$defs": {
    "Feasibility": {
      "additionalProperties": false,
      "properties": {
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "reasons": {
          "description": "Human-readable; required when infeasible",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "feasible"
      ],
      "title": "Feasibility",
      "type": "object"
    },
    "ReplayWindow": {
      "additionalProperties": false,
      "properties": {
        "years": {
          "items": {
            "type": "integer"
          },
          "title": "Years",
          "type": "array"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the window cannot be replayed",
          "title": "Reason"
        },
        "in_sample_pool": {
          "description": "False: held out or outside the pool; replay only, never a range",
          "title": "In Sample Pool",
          "type": "boolean"
        },
        "rain_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total usable rainfall over the window's years",
          "title": "Rain Mm"
        }
      },
      "required": [
        "years",
        "enabled",
        "in_sample_pool"
      ],
      "title": "ReplayWindow",
      "type": "object"
    },
    "RunRequest": {
      "additionalProperties": false,
      "description": "A comparison run with the D6 supported edits only. Unsupported edits are rejected, never approximated.",
      "properties": {
        "site_id": {
          "title": "Site Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/SimulationMode",
          "default": "irrigation_needed"
        },
        "allocation_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Net irrigation allocation per irrigated season (mm); fixed_allocation only",
          "title": "Allocation Mm"
        },
        "planting_shift_days": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "strategy_id -> days to move every crop season (|days| <= 14, D6)",
          "title": "Planting Shift Days",
          "type": "object"
        },
        "n_paths": {
          "default": 200,
          "maximum": 500,
          "minimum": 20,
          "title": "N Paths",
          "type": "integer"
        },
        "seed": {
          "default": 20261114,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "site_id"
      ],
      "title": "RunRequest",
      "type": "object"
    },
    "SeasonPlan": {
      "additionalProperties": false,
      "properties": {
        "crop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None = fallow",
          "title": "Crop Id"
        },
        "plant_date": {
          "format": "date",
          "title": "Plant Date",
          "type": "string"
        },
        "end_date": {
          "description": "Harvest or termination date",
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "irrigation_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irrigation Rule"
        },
        "residue_management": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residue Management"
        },
        "usual_yield_t_ha": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The farmer's own usual yield for this crop; never a prediction",
          "title": "Usual Yield T Ha"
        }
      },
      "required": [
        "crop_id",
        "plant_date",
        "end_date"
      ],
      "title": "SeasonPlan",
      "type": "object"
    },
    "SimulationMode": {
      "enum": [
        "irrigation_needed",
        "fixed_allocation"
      ],
      "title": "SimulationMode",
      "type": "string"
    },
    "SimulationRun": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "site_id": {
          "title": "Site Id",
          "type": "string"
        },
        "strategy_ids": {
          "items": {
            "type": "string"
          },
          "title": "Strategy Ids",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/SimulationMode"
        },
        "allocation_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for fixed_allocation mode",
          "title": "Allocation Mm"
        },
        "weather_source_id": {
          "description": "Exactly one rainfall/weather source per run",
          "title": "Weather Source Id",
          "type": "string"
        },
        "resampling_method": {
          "title": "Resampling Method",
          "type": "string"
        },
        "sample_period": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            }
          ],
          "title": "Sample Period",
          "type": "array"
        },
        "n_paths": {
          "title": "N Paths",
          "type": "integer"
        },
        "horizon_years": {
          "title": "Horizon Years",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "input_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Versions",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "site_id",
        "strategy_ids",
        "mode",
        "weather_source_id",
        "resampling_method",
        "sample_period",
        "n_paths",
        "horizon_years",
        "seed",
        "model_version",
        "created_at"
      ],
      "title": "SimulationRun",
      "type": "object"
    },
    "Strategy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "site_id": {
          "title": "Site Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "is_baseline": {
          "default": false,
          "title": "Is Baseline",
          "type": "boolean"
        },
        "seasons": {
          "items": {
            "$ref": "#/$defs/SeasonPlan"
          },
          "title": "Seasons",
          "type": "array"
        },
        "feasibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Feasibility"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "site_id",
        "name",
        "seasons"
      ],
      "title": "Strategy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A stored run with everything the comparison screens need besides results and deltas.",
  "properties": {
    "run": {
      "$ref": "#/$defs/SimulationRun"
    },
    "request": {
      "$ref": "#/$defs/RunRequest"
    },
    "strategies": {
      "description": "As simulated (edits applied), each with its feasibility",
      "items": {
        "$ref": "#/$defs/Strategy"
      },
      "title": "Strategies",
      "type": "array"
    },
    "replay_windows": {
      "items": {
        "$ref": "#/$defs/ReplayWindow"
      },
      "title": "Replay Windows",
      "type": "array"
    },
    "excluded_blocks": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Excluded Blocks",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "scenario_notes": {
      "description": "How planting dates were derived",
      "items": {
        "type": "string"
      },
      "title": "Scenario Notes",
      "type": "array"
    },
    "unsupported_claims": {
      "description": "Shown as unavailable, never estimated",
      "items": {
        "type": "string"
      },
      "title": "Unsupported Claims",
      "type": "array"
    },
    "cached": {
      "default": false,
      "description": "True: an identical earlier run was returned",
      "title": "Cached",
      "type": "boolean"
    }
  },
  "required": [
    "run",
    "request",
    "strategies",
    "replay_windows",
    "source_ids"
  ],
  "title": "RunDetail",
  "type": "object"
}
