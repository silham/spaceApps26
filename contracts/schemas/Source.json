{
  "$defs": {
    "ValueKind": {
      "description": "Keeps observed, estimated, farmer, reanalysis, literature and simulated values distinguishable.",
      "enum": [
        "observed",
        "reanalysis",
        "modeled",
        "estimated",
        "farmer_input",
        "literature",
        "simulated",
        "demo"
      ],
      "title": "ValueKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Source register entry. Only list sources actually used (AGENTS.md rule 2).",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "product": {
      "title": "Product",
      "type": "string"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Version"
    },
    "variables": {
      "items": {
        "type": "string"
      },
      "title": "Variables",
      "type": "array"
    },
    "units": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "variable -> unit",
      "title": "Units",
      "type": "object"
    },
    "kind": {
      "$ref": "#/$defs/ValueKind"
    },
    "spatial_resolution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spatial Resolution"
    },
    "temporal_resolution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temporal Resolution"
    },
    "coverage_start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage Start"
    },
    "coverage_end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage End"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieved At"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "attribution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution"
    },
    "qa_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qa Notes"
    },
    "limitations": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limitations"
    },
    "footprint_geojson": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Native pixel/grid footprint",
      "title": "Footprint Geojson"
    },
    "raw_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Path of the immutable raw snapshot, relative to data/",
      "title": "Raw Path"
    },
    "raw_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Sha256"
    },
    "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "provider",
    "product",
    "variables",
    "units",
    "kind"
  ],
  "title": "Source",
  "type": "object"
}
