    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "years": {
      "items": {
        "type": "integer"
      },
      "title": "Years",
      "type": "array"
    },
    "in_sample_pool": {
      "title": "In Sample Pool",
      "type": "boolean"
    },
    "dates": {
      "description": "Strategy-calendar dates (the comparison horizon)",
      "items": {
        "format": "date",
        "type": "string"
      },
      "title": "Dates",
      "type": "array"
    },
    "source_dates": {
      "description": "The historical dates whose weather is replayed",
      "items": {
        "format": "date",
        "type": "string"
      },
      "title": "Source Dates",
      "type": "array"
    },
    "rain_mm": {
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Rain Mm",
      "type": "array"
    },
    "et0_mm": {
      "items": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Et0 Mm",
      "type": "array"
    },
    "series": {
      "items": {
        "$ref": "#/$defs/ReplaySeries"
      },
