  "required": [
    "run_id",
    "years",
    "in_sample_pool",
    "dates",
    "source_dates",
    "rain_mm",
    "et0_mm",
    "series",
    "turning_point",
    "turning_point_reason",
    "source_ids"
  ],
  "title": "ReplayTrace",
  "type": "object"
