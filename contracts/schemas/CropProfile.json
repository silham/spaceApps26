{
  "$defs": {
    "ParamValue": {
      "additionalProperties": false,
      "description": "A literature/local parameter. ``value=None`` means missing: the claim it supports is blocked.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Citation (DOI/URL/table). Required when value is set.",
          "title": "Reference"
        },
        "region_relevance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Relevance"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lower bound in ``unit`` if the source documents one",
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upper bound in ``unit`` if the source documents one",
          "title": "High"
        },
        "bounds_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What low/high are, e.g. 'documented range (SSURGO awc_l/awc_h)' or 'declared assumption ±20%'. Never a statistical interval unless one was actually computed.",
          "title": "Bounds Kind"
        }
      },
      "required": [
        "value",
        "unit",
        "reference"
      ],
      "title": "ParamValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "kc_ini": {
      "$ref": "#/$defs/ParamValue"
    },
    "kc_mid": {
      "$ref": "#/$defs/ParamValue"
    },
    "kc_end": {
      "$ref": "#/$defs/ParamValue"
    },
    "stage_lengths_days": {
      "additionalProperties": {
        "$ref": "#/$defs/ParamValue"
      },
      "propertyNames": {
        "enum": [
          "ini",
          "dev",
          "mid",
          "late"
        ]
      },
      "title": "Stage Lengths Days",
      "type": "object"
    },
    "max_root_depth_m": {
      "$ref": "#/$defs/ParamValue"
    },
    "depletion_fraction_p": {
      "$ref": "#/$defs/ParamValue"
    },
    "ky_season": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParamValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "FAO-33 seasonal yield response factor Ky (unit '-'); null blocks the yield claim for this crop"
    },
    "planting_window": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "MM-DD start/end",
      "title": "Planting Window"
    },
    "family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Botanical family, e.g. 'Poaceae'",
      "title": "Family"
    },
    "legume": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Fixes nitrogen with rhizobia (a legume)",
      "title": "Legume"
    },
    "traits_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Citation for family and legume",
      "title": "Traits Reference"
    },
    "t_base_c": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParamValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Base temperature below which the crop does not develop (degC)"
    },
    "table11_planting_months": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Planting month(s) of the FAO-56 Table 11 row the stage lengths come from (northern hemisphere)",
      "title": "Table11 Planting Months"
    },
    "is_cover_crop": {
      "default": false,
      "title": "Is Cover Crop",
      "type": "boolean"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "is_demo": {
      "default": false,
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "name",
    "kc_ini",
    "kc_mid",
    "kc_end",
    "stage_lengths_days",
    "max_root_depth_m",
    "depletion_fraction_p"
  ],
  "title": "CropProfile",
  "type": "object"
}
