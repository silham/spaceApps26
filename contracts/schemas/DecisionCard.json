{
  "$defs": {
    "CropProfile": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kc_ini": {
          "$ref": "#/$defs/ParamValue"
        },
        "kc_mid": {
          "$ref": "#/$defs/ParamValue"
        },
        "kc_end": {
          "$ref": "#/$defs/ParamValue"
        },
        "stage_lengths_days": {
          "additionalProperties": {
            "$ref": "#/$defs/ParamValue"
          },
          "propertyNames": {
            "enum": [
              "ini",
              "dev",
              "mid",
              "late"
            ]
          },
          "title": "Stage Lengths Days",
          "type": "object"
        },
        "max_root_depth_m": {
          "$ref": "#/$defs/ParamValue"
        },
        "depletion_fraction_p": {
          "$ref": "#/$defs/ParamValue"
        },
        "ky_season": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParamValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "FAO-33 seasonal yield response factor Ky (unit '-'); null blocks the yield claim for this crop"
        },
        "planting_window": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MM-DD start/end",
          "title": "Planting Window"
        },
        "family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Botanical family, e.g. 'Poaceae'",
          "title": "Family"
        },
        "legume": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fixes nitrogen with rhizobia (a legume)",
          "title": "Legume"
        },
        "traits_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Citation for family and legume",
          "title": "Traits Reference"
        },
        "t_base_c": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParamValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Base temperature below which the crop does not develop (degC)"
        },
        "table11_planting_months": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Planting month(s) of the FAO-56 Table 11 row the stage lengths come from (northern hemisphere)",
          "title": "Table11 Planting Months"
        },
        "is_cover_crop": {
          "default": false,
          "title": "Is Cover Crop",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "kc_ini",
        "kc_mid",
        "kc_end",
        "stage_lengths_days",
        "max_root_depth_m",
        "depletion_fraction_p"
      ],
      "title": "CropProfile",
      "type": "object"
    },
    "FarmerContext": {
      "additionalProperties": false,
      "description": "Farmer-confirmed inputs (value kind farmer_input). Unconfirmed fields stay null, never guessed.",
      "properties": {
        "value_kind": {
          "const": "farmer_input",
          "default": "farmer_input",
          "title": "Value Kind",
          "type": "string"
        },
        "confirmed": {
          "default": false,
          "title": "Confirmed",
          "type": "boolean"
        },
        "planting_history": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planting History"
        },
        "harvest_history": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harvest History"
        },
        "soil_confirmed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Farmer agrees with the stored soil profile",
          "title": "Soil Confirmed"
        },
        "soil_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Soil Notes"
        },
        "irrigation_allocation_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "mm per irrigated season",
          "title": "Irrigation Allocation Mm"
        },
        "equipment": {
          "items": {
            "type": "string"
          },
          "title": "Equipment",
          "type": "array"
        },
        "available_crop_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Crops the farmer can grow; None = not stated (all catalog crops allowed)",
          "title": "Available Crop Ids"
        },
        "market_use": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Use"
        },
        "current_crop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Crop Id"
        },
        "current_plant_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Plant Date"
        },
        "last_harvest_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Harvest Date"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "title": "FarmerContext",
      "type": "object"
    },
    "Feasibility": {
      "additionalProperties": false,
      "properties": {
        "feasible": {
          "title": "Feasible",
          "type": "boolean"
        },
        "reasons": {
          "description": "Human-readable; required when infeasible",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "feasible"
      ],
      "title": "Feasibility",
      "type": "object"
    },
    "PairedDelta": {
      "additionalProperties": false,
      "description": "Strategy minus baseline on the same weather path, summarised across paths (paired comparison).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "strategy_id": {
          "title": "Strategy Id",
          "type": "string"
        },
        "baseline_strategy_id": {
          "title": "Baseline Strategy Id",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "p10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P10"
        },
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P90"
        },
        "range_label": {
          "default": "central 80% simulation range (p10–p90)",
          "title": "Range Label",
          "type": "string"
        },
        "better_direction": {
          "anyOf": [
            {
              "enum": [
                "lower",
                "higher"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which direction is preferable for this metric; None = no preferred direction",
          "title": "Better Direction"
        },
        "share_better": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fraction of paths where the strategy beats the baseline",
          "title": "Share Better"
        },
        "share_worse": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Share Worse"
        },
        "sample_count": {
          "title": "Sample Count",
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "run_id",
        "strategy_id",
        "baseline_strategy_id",
        "metric",
        "unit",
        "p10",
        "p50",
        "p90",
        "better_direction",
        "share_better",
        "share_worse",
        "sample_count"
      ],
      "title": "PairedDelta",
      "type": "object"
    },
    "ParamValue": {
      "additionalProperties": false,
      "description": "A literature/local parameter. ``value=None`` means missing: the claim it supports is blocked.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Citation (DOI/URL/table). Required when value is set.",
          "title": "Reference"
        },
        "region_relevance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region Relevance"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Lower bound in ``unit`` if the source documents one",
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upper bound in ``unit`` if the source documents one",
          "title": "High"
        },
        "bounds_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What low/high are, e.g. 'documented range (SSURGO awc_l/awc_h)' or 'declared assumption ±20%'. Never a statistical interval unless one was actually computed.",
          "title": "Bounds Kind"
        }
      },
      "required": [
        "value",
        "unit",
        "reference"
      ],
      "title": "ParamValue",
      "type": "object"
    },
    "Priorities": {
      "additionalProperties": false,
      "description": "Farmer priorities rank feasible options; they never override hard constraints.",
      "properties": {
        "conserve_water": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "title": "Conserve Water",
          "type": "integer"
        },
        "protect_soil": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "title": "Protect Soil",
          "type": "integer"
        }
      },
      "title": "Priorities",
      "type": "object"
    },
    "Result": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "strategy_id": {
          "title": "Strategy Id",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "p10": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P10"
        },
        "p50": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P50"
        },
        "p90": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P90"
        },
        "range_label": {
          "default": "central 80% simulation range (p10–p90)",
          "title": "Range Label",
          "type": "string"
        },
        "sample_count": {
          "title": "Sample Count",
          "type": "integer"
        },
        "season_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-season metrics: index in the plant-date order",
          "title": "Season Index"
        },
        "crop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-season metrics: the crop of that season",
          "title": "Crop Id"
        },
        "trace_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parquet traces under results/",
          "title": "Trace Path"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "run_id",
        "strategy_id",
        "metric",
        "unit",
        "p10",
        "p50",
        "p90",
        "sample_count",
        "source_ids"
      ],
      "title": "Result",
      "type": "object"
    },
    "RunRequest": {
      "additionalProperties": false,
      "description": "A comparison run with the D6 supported edits only. Unsupported edits are rejected, never approximated.",
      "properties": {
        "site_id": {
          "title": "Site Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/SimulationMode",
          "default": "irrigation_needed"
        },
        "allocation_mm": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Net irrigation allocation per irrigated season (mm); fixed_allocation only",
          "title": "Allocation Mm"
        },
        "planting_shift_days": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "strategy_id -> days to move every crop season (|days| <= 14, D6)",
          "title": "Planting Shift Days",
          "type": "object"
        },
        "n_paths": {
          "default": 200,
          "maximum": 500,
          "minimum": 20,
          "title": "N Paths",
          "type": "integer"
        },
        "seed": {
          "default": 20261114,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "site_id"
      ],
      "title": "RunRequest",
      "type": "object"
    },
    "SeasonPlan": {
      "additionalProperties": false,
      "properties": {
        "crop_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "None = fallow",
          "title": "Crop Id"
        },
        "plant_date": {
          "format": "date",
          "title": "Plant Date",
          "type": "string"
        },
        "end_date": {
          "description": "Harvest or termination date",
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "irrigation_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irrigation Rule"
        },
        "residue_management": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residue Management"
        },
        "usual_yield_t_ha": {
          "anyOf": [
            {
              "maximum": 30,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The farmer's own usual yield for this crop; never a prediction",
          "title": "Usual Yield T Ha"
        }
      },
      "required": [
        "crop_id",
        "plant_date",
        "end_date"
      ],
      "title": "SeasonPlan",
      "type": "object"
    },
    "SimulationMode": {
      "enum": [
        "irrigation_needed",
        "fixed_allocation"
      ],
      "title": "SimulationMode",
      "type": "string"
    },
    "SimulationRun": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "site_id": {
          "title": "Site Id",
          "type": "string"
        },
        "strategy_ids": {
          "items": {
            "type": "string"
          },
          "title": "Strategy Ids",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/SimulationMode"
        },
        "allocation_mm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for fixed_allocation mode",
          "title": "Allocation Mm"
        },
        "weather_source_id": {
          "description": "Exactly one rainfall/weather source per run",
          "title": "Weather Source Id",
          "type": "string"
        },
        "resampling_method": {
          "title": "Resampling Method",
          "type": "string"
        },
        "sample_period": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date",
              "type": "string"
            }
          ],
          "title": "Sample Period",
          "type": "array"
        },
        "n_paths": {
          "title": "N Paths",
          "type": "integer"
        },
        "horizon_years": {
          "title": "Horizon Years",
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "input_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Versions",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "site_id",
        "strategy_ids",
        "mode",
        "weather_source_id",
        "resampling_method",
        "sample_period",
        "n_paths",
        "horizon_years",
        "seed",
        "model_version",
        "created_at"
      ],
      "title": "SimulationRun",
      "type": "object"
    },
    "SoilRuleResult": {
      "additionalProperties": false,
      "description": "A soil-health rule of thumb for a rotation (D16), stated conditionally, never a numeric gain.",
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "status": {
          "enum": [
            "met",
            "not_met",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "label",
        "status",
        "explanation",
        "reference"
      ],
      "title": "SoilRuleResult",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Source register entry. Only list sources actually used (AGENTS.md rule 2).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "product": {
          "title": "Product",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
