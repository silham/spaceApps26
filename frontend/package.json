{
  "name": "ftm-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "gen:types": "json2ts -i ../contracts/schemas/bundle.json -o src/types/contracts.ts --bannerComment \"/* Generated from contracts/schemas/bundle.json by json-schema-to-typescript. Do not edit; run make contracts. */\" --additionalProperties false",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "echarts": "5.5.1",
    "maplibre-gl": "4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.49.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "json-schema-to-typescript": "15.0.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11"
  }
}
